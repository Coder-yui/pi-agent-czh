{
  "mcpServers": {
    "modern-stdio": {
      "command": "node",
      "args": ["/path/to/your-2026-07-28-mcp-server.mjs"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<your-token-here>"
      }
    },
    "remote-example": {
      "url": "http://localhost:3000/mcp",
      "headers": {
        "Authorization": "Bearer <token>"
      }
    }
  }
}
